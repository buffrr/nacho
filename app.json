{
  "expo": {
    "name": "nacho",
    "slug": "nacho",
    "version": "0.1.1",
    "scheme": "nacho",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.impervious.nacho",
      "buildNumber": "8",
      "associatedDomains": [
        "applinks:nacho.io"
      ],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.impervious.nacho",
      "versionCode": 18,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "nacho.io", "pathPattern": ".*@.*" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Camera access is required to scan QR codes and handles",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-iap",
      "expo-font",
      "expo-sqlite",
      "expo-sharing",
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Authenticate to sign a handle sale or transfer"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5bfb056c-2b5a-43d7-9143-faf24508e03d"
      }
    },
    "owner": "impervious"
  }
}
